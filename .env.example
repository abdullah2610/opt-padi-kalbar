# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=composites

# ── Copernicus Data Space Ecosystem (openEO) ────────────────────────────────
# Register at https://dataspace.copernicus.eu and create an OAuth client
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
CDSE_OPENEO_URL=https://openeo.dataspace.copernicus.eu

# ── TiTiler (deployed separately, see workers/etl/README) ───────────────────
TITILER_BASE_URL=https://opt-padi-titiler.fly.dev

# ── Open-Meteo (no auth) ────────────────────────────────────────────────────
WEATHER_LAT=-0.02
WEATHER_LON=109.34

# ── Cron / GH Actions ───────────────────────────────────────────────────────
CRON_SECRET=

# ── Frontend (Vite) ─────────────────────────────────────────────────────────
VITE_API_BASE_URL=
VITE_DEFAULT_BBOX=108.0,-3.0,114.5,2.5
VITE_DEFAULT_CENTER=109.34,-0.02
VITE_DEFAULT_ZOOM=7
VITE_SENTRY_DSN=

# ── ETL tuning ──────────────────────────────────────────────────────────────
ETL_MIN_CLEAR_PCT=30
ETL_JOB_POLL_SEC=20
ETL_KAB_DELAY_SEC=300
